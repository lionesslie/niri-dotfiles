{
  "layer": "top",
  "position": "top",
  "height": 26,
  "margin": "6 8 0 8",
  "spacing": 6,
  "modules-left": ["custom/launcher", "niri/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "tray", "custom/power"],

  "custom/launcher": {
    "format": "\uf313",
    "tooltip": false,
    "on-click": "pkill rofi || rofi -show drun"
  },
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": { "focused": "●", "active": "●", "default": "○" }
  },
  "clock": {
    "format": "{:%H:%M  ·  %d %b %a}",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "{volume}%",
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{essid} {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "tray": { "icon-size": 14, "spacing": 8 },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/rofi/power.sh"
  }
}